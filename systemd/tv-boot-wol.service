[Unit]
Description=Wake Samsung TV via WoL and HDMI-CEC at Boot
After=network.target network-online.target NetworkManager.service
Wants=network-online.target
Before=display-manager.service sddm.service

[Service]
Type=oneshot
RemainAfterExit=yes
# @PYTHON@ and @BIN_DIR@ are substituted by deploy.sh for the installing user.
ExecStart=@PYTHON@ @BIN_DIR@/boot_wol.py
TimeoutSec=10

[Install]
WantedBy=multi-user.target
