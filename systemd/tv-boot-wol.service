[Unit]
Description=Wake Samsung TV via WoL and HDMI-CEC at Boot
After=network.target network-online.target NetworkManager.service
Wants=network-online.target
Before=display-manager.service sddm.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/home/mike/.local/bin/boot_wol.py
TimeoutSec=10

[Install]
WantedBy=multi-user.target
