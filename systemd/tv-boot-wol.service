[Unit]
Description=Wake TV via the configured power backend at Boot
After=network.target network-online.target NetworkManager.service
Wants=network-online.target
Before=display-manager.service sddm.service

[Service]
Type=oneshot
RemainAfterExit=yes
# @PYTHON@, @BIN_DIR@ and @TV_BACKEND@ are substituted by deploy.sh.
Environment=TV_BACKEND=@TV_BACKEND@
ExecStart=@PYTHON@ @BIN_DIR@/boot_wol.py
TimeoutSec=10

[Install]
WantedBy=multi-user.target
